# WalletConnect / Reown Project ID —— RainbowKit 连接钱包必需
# 获取：https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Alchemy API key —— RPC 节点。留空则回退到各链默认公共 RPC
# 获取：https://alchemy.com
NEXT_PUBLIC_ALCHEMY_ID=

# Etherscan API key —— 授权历史查询
# 获取：https://etherscan.io/apis
ETHERSCAN_API_KEY=

# 可选：仅本地开发时让服务端 fetch 走 HTTP/混合代理
DEV_PROXY=

# 可选但推荐用于生产：跨 Serverless 实例共享限流、Etherscan 请求节流与短期缓存
# 获取：https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
